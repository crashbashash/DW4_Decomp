/* One row of a platform capability manager's table: the capability, its IG_GFX_CAPABILITY_* name and
 * the platform's value. */
struct igGfxCapabilityEntry {
    int capability;
    const char *name;
    int value;

    igGfxCapabilityEntry(int capability_, const char *name_, int value_) {
        capability = capability_;
        name = name_;
        value = value_;
    }
};

#define CAP(n, name, value) igGfxCapabilityEntry(n, "IG_GFX_CAPABILITY_" name, value)

